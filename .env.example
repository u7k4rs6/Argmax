# Copy to .env and fill in. .env is gitignored; never commit it.
# Every variable name present, every value empty.

# A DEDICATED Argmax key. Not the key used with self-consistency-backfire:
# that repo is a citable artifact people will clone, and its key must not be
# able to spend Argmax credits.
TOGETHER_API_KEY=

TOGETHER_BASE_URL=https://api.together.xyz/v1

# Hard spend ceiling in USD. There is no default: the runner refuses to start
# without it, because a default becomes the real limit.
ARGMAX_SPEND_CEILING_USD=
